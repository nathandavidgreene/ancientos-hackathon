# Copy to .env (git-ignored). Never commit real values.
X_CLIENT_ID=
X_REDIRECT_URI=http://127.0.0.1:8080/callback
MODAL_LLAMA_URL=
ANCIENTOS_LOCAL_LLM_URL=
ANCIENTOS_LOCAL_LLM_MODEL=
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
MUSE_REASONING_EFFORT=low
ANCIENTOS_HOME=
DECISION_LOG_PATH=
# Paid calls are off by default. Must equal "1" to allow paid model calls.
ANCIENTOS_ALLOW_PAID=
ENABLE_PAID_CALLS=false
# Per-task Jev opt-in (comma list: intent,bookmarks). Empty/unset = Jev off;
# unknown values are an error. Opt a task in only where evals show Jev wins.
ANCIENTOS_JEV_TASKS=
# Jev try-it threshold (noul >= threshold answers yes). Default 0.3 when
# unset, unparseable, NaN, or outside [0,1]. The eval bin's --jev-threshold
# flag overrides this.
ANCIENTOS_JEV_TRY_IT_THRESHOLD=
# Link/media enrichment fetches (plain HTTP GET of stored bookmark URLs).
# Must equal "1" to fetch; default off means no network and empty enrichment.
ANCIENTOS_FETCH_LINKS=
# Optional hosted-route ceiling overrides (public|internal|confidential|
# restricted). May only LOWER a ceiling, never raise it above the compiled
# default (Public for hosted routes); unknown values fall back to it.
# ANCIENTOS_CEILING_MUSE=public
# ANCIENTOS_CEILING_JEV=public
# ANCIENTOS_CEILING_MODAL=public
