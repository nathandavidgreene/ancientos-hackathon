# Copy to .env (git-ignored). Never commit real values.
X_CLIENT_ID=
X_REDIRECT_URI=http://127.0.0.1:8080/callback
MODAL_LLAMA_URL=
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
